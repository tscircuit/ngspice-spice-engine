{
  "name": "@tscircuit/ngspice-spice-engine",
  "version": "0.0.20",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/ngspice-spice-engine"
  },
  "description": "A tscircuit-compatible SPICE engine using ngspice.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup-node ./lib/index.ts --dts --format esm",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "biome format --write .",
    "format:check": "biome format --diagnostic-level=error .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tscircuit/props": "^0.0.592",
    "bun-match-svg": "^0.0.14",
    "circuit-json": "^0.0.454",
    "circuit-to-svg": "^0.0.393",
    "format-si-unit": "^0.0.7",
    "@biomejs/biome": "^2.2.7",
    "@types/bun": "latest",
    "spicets": "^0.0.4",
    "tscircuit": "^0.0.805",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "circuit-json": "*",
    "@tscircuit/props": "*",
    "spicets": "*"
  }
}
